<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.aribaweb</groupId>
        <artifactId>aribaweb-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>aribaweb-core</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>org.aribaweb</groupId>
            <artifactId>aribaweb-util</artifactId>
        </dependency>
        <dependency>
            <groupId>org.aribaweb</groupId>
            <artifactId>aribaweb-expr</artifactId>
        </dependency>
        <dependency>
            <groupId>ext-lib</groupId>
            <artifactId>servlet-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ext-lib</groupId>
            <artifactId>log4j</artifactId>
        </dependency>
        <dependency>
            <groupId>ext-lib</groupId>
            <artifactId>jakarta-oro</artifactId>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}</sourceDirectory>
        <resources>
            <resource>
                <directory>${project.basedir}/resource/webserver</directory>
                <targetPath>docroot/ariba/ui/aribaweb</targetPath>
                <excludes>
                    <exclude>jquery.js</exclude>
                    <exclude>Util.js</exclude>
                    <exclude>Dom.js</exclude>
                    <exclude>Event.js</exclude>
                    <exclude>Input.js</exclude>
                    <exclude>Request.js</exclude>
                    <exclude>Refresh.js</exclude>
                    <exclude>Handlers.js</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <version>2.1.0</version>
                <dependencies>
                    <dependency>
                        <groupId>ext-lib</groupId>
                        <artifactId>yuicompressor</artifactId>
                        <version>1.0</version>
                        <scope>system</scope>
                        <systemPath>${maven.multiModuleProjectDirectory}/lib/ext-build/yuicompressor-2.3.5.jar</systemPath>
                    </dependency>
                    <dependency>
                        <groupId>org.codehaus.groovy</groupId>
                        <artifactId>groovy</artifactId>
                        <version>3.0.15</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>execute</goal>
                        </goals>
                        <configuration>
                            <scripts>
                                <script><![CDATA[
                                    def srcDir = new File(project.basedir, "resource/webserver")
                                    def targetDir = new File(project.build.outputDirectory, "docroot/ariba/ui/aribaweb")
                                    targetDir.mkdirs()

                                    // 1. Merge JS files
                                    def filesToMerge = ["jquery.js", "Util.js", "Dom.js", "Event.js", "Input.js", "Request.js", "Refresh.js", "Handlers.js"]
                                    def mergedContent = new StringBuilder()
                                    filesToMerge.each { fileName ->
                                        def file = new File(srcDir, fileName)
                                        if (file.exists()) {
                                            mergedContent.append(file.text).append("\n")
                                        } else {
                                            log.warn("JS File not found for merging: " + file.absolutePath)
                                        }
                                    }

                                    def tempMergedFile = new File(project.build.directory, "aribaweb_all_uncompressed.js")
                                    tempMergedFile.parentFile.mkdirs()
                                    tempMergedFile.text = mergedContent.toString()

                                    // 2. Compress JS using YUI Compressor
                                    def compactFile = new File(targetDir, "aribaweb_all.js")
                                    log.info("Compressing merged JS to: " + compactFile.absolutePath)
                                    try {
                                        com.yahoo.platform.yui.compressor.YUICompressor.main([
                                            "--type", "js",
                                            "-o", compactFile.absolutePath,
                                            tempMergedFile.absolutePath
                                        ] as String[])
                                    } catch (Exception e) {
                                        log.error("Failed to compress JS using YUI Compressor, copying uncompressed version instead", e)
                                        compactFile.text = tempMergedFile.text
                                    }
                                ]]></script>
                            </scripts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
