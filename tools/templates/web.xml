<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
  <display-name>$servlet.displayName</display-name>
  <description>$servlet.description</description>

  <filter>
    <filter-name>AbacusResourceRewriteFilter</filter-name>
    <filter-class>ariba.ui.servletadaptor.AbacusResourceRewriteFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AbacusResourceRewriteFilter</filter-name>
    <url-pattern>/docroot/abacus/*</url-pattern>
  </filter-mapping>

  <servlet>
    <servlet-name>$servlet.name</servlet-name>
    <servlet-class>$servlet.class</servlet-class>
    <load-on-startup _ifTrue="$servlet.init.onstartup">100</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>$servlet.name</servlet-name>
    <url-pattern>/$app.name/*</url-pattern>
  </servlet-mapping>
</web-app>
